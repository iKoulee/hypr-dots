[Unit]
Description=Hyprpaper wallpaper daemon
Documentation=https://github.com/hyprwm/hyprpaper
PartOf=hyprland-session.target
After=hyprland-session.target
# Výchozí 5/10s se s RestartSec=3 nikdy nevyčerpá (restarty jsou ~4 s od sebe),
# takže selhání GL inicializace vede na nekonečnou smyčku core dumpů. 60 s to zarazí.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# POZOR: sem nepatří UnsetEnvironment=LD_LIBRARY_PATH (na rozdíl od keepassxc.service
# a hyprpolkitagent.service). hyprpaper přes něj hledá systémový GBM/EGL stack —
# bez něj spadne na ABRT. Viz sekce „Tapeta (hyprpaper)" v CLAUDE.md.
#
# Proměnná se sem dostává adresně, ne přes `import-environment` v hyprland.lua —
# ta by ji dala i D-Bus aktivovaným procesům (snap userd, xdg-desktop-portal) a jimi
# spouštěné systémové aplikace by se rozbily. Viz sekce LibreOffice v CLAUDE.md.
Environment=LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/gbm
ExecStart=%h/.nix-profile/bin/hyprpaper
Restart=on-failure
RestartSec=3

[Install]
WantedBy=hyprland-session.target
