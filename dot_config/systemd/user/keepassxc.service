[Unit]
Description=KeePassXC password manager
Documentation=https://keepassxc.org/docs/
PartOf=hyprland-session.target
After=hyprland-session.target waybar.service

[Service]
# start-hyprland-nix nastavuje kvůli NVIDII LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu.
# Do systemd se ta proměnná dnes nedostává — v seznamech u import-environment
# a dbus-update-activation-environment v hyprland.lua schválně není (viz CLAUDE.md,
# sekce LibreOffice). Řádek níž je pojistka pro případ, že by tam znovu prosákla:
# nixová Qt binárka by si natáhla systémové Qt (keepassxc 2.7.12 chce Qt 5.15.19,
# systém má 5.15.18) a spadla na "requires Qt 5.15.19, found Qt 5.15.18".
UnsetEnvironment=LD_LIBRARY_PATH
# Qt se rozhoduje mezi SNI a starým X11 systrayem v okamžiku vytvoření tray ikony,
# tedy hned při startu. Bez běžícího org.kde.StatusNotifierWatcher (poskytuje ho
# waybar) spadne na X11 systray, který v Hyprlandu nikdo nemá — ikona pak není
# nikde a nic se nezaloguje. Samotné After=waybar.service nestačí, waybar jméno
# registruje až ~400 ms po startu procesu (naměřeno 370-395 ms na čtyřech boot
# cyklech). Prefix "-" je schválně: bez waybaru má keepassxc naběhnout i tak,
# kvůli Secret Service. Timeout je proto krátký — čekání jen překlenuje ty
# stamilisekundy a delší by škodilo dvakrát: odkládá Secret Service a hlavně
# rozšiřuje okno, ve kterém D-Bus aktivace org.freedesktop.secrets (Exec= míří
# na shim ~/.local/bin/keepassxc) spustí druhou instanci mimo tenhle unit.
ExecStartPre=-/usr/bin/gdbus wait --session --timeout 10 org.kde.StatusNotifierWatcher
ExecStart=%h/.nix-profile/bin/keepassxc
Restart=on-failure
RestartSec=3

[Install]
WantedBy=hyprland-session.target
