[Unit]
Description=playerctld (MPRIS proxy sledující naposledy aktivní přehrávač)
Documentation=https://github.com/altdesktop/playerctl
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
ExecStart=%h/.nix-profile/bin/playerctld
Restart=on-failure
RestartSec=3

[Install]
WantedBy=hyprland-session.target
