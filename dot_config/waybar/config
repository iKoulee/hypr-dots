{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 8,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["mpris", "clock"],
    "modules-right": ["custom/dnd", "tray", "cpu", "memory", "network", "hyprland/language", "pulseaudio"],

    "custom/dnd": {
        "exec": "$HOME/.local/bin/hypr-dnd status",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "$HOME/.local/bin/hypr-dnd toggle",
        "tooltip": true
    },

    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "player-icons": {
            "default": "",
            "firefox": "",
            "vivaldi": "",
            "chromium": "",
            "spotify": "",
            "youtube-music": ""
        },
        "status-icons": {
            "paused": ""
        },
        "dynamic-order": ["title", "artist"],
        "dynamic-importance-order": ["title", "artist"],
        "dynamic-separator": "  ·  ",
        "title-len": 42,
        "artist-len": 22,
        "dynamic-len": 56,
        "min-length": 62,
        "max-length": 62,
        "on-click-right": "$HOME/.local/bin/hypr-player raise",
        "tooltip-format": "{player} — {status}\n{title}\n{artist}\n{album}"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "\uf192",
            "default": "\uf111"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },
    
    "clock": {
        "format": "\uf017 {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    
    "cpu": {
        "format": "\uf2db {usage}%",
        "interval": 2,
        "tooltip": true
    },
    
    "memory": {
        "format": "\uf0c9 {}%",
        "interval": 2
    },
    
    "network": {
        "format-ethernet": "\uf796 {ipaddr}",
        "format-disconnected": "⚠ Odpojeno",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-cs": "CZ"
    }, 

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "tooltip-format": "{desc}",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "$HOME/.local/bin/hypr-audio-menu output"
    },
    
    "tray": {
        "spacing": 10,
        "icon-size": 18
    }
}
